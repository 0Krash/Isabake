{
  "name": "ui",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "node scripts/run-expo.js start --go -c --lan --port 8082",
    "start:tunnel": "node scripts/run-expo.js start --go -c --tunnel --port 8082",
    "android": "node scripts/run-expo.js start --go --android --lan --port 8082",
    "android:usb": "adb reverse tcp:8082 tcp:8082 && adb reverse tcp:3000 tcp:3000 && node scripts/run-expo.js start --android --localhost --port 8082",
    "android:usb:open": "adb reverse tcp:8082 tcp:8082 && adb reverse tcp:3000 tcp:3000 && adb shell am start -a android.intent.action.VIEW -d exp://127.0.0.1:8082",
    "build:android:dev": "eas build --platform android --profile development --non-interactive",
    "build:android:dev-apk": "eas build --platform android --profile dev-apk --non-interactive",
    "build:android:dev-apk:local": "ANDROID_HOME=$HOME/Library/Android/sdk ANDROID_SDK_ROOT=$HOME/Library/Android/sdk eas build --local --platform android --profile dev-apk --output ./isabake-dev.apk",
    "build:android:preview": "eas build --platform android --profile preview --non-interactive",
    "ios": "node scripts/run-expo.js start --go --ios --lan --port 8082",
    "web": "node scripts/run-expo.js start --web --lan --port 8082",
    "icon:import": "node scripts/import-svg-icon.mjs",
    "test": "jest --runInBand",
    "check:syntax": "node scripts/checkSyntax.js",
    "check:no-startup-test-wiring": "node scripts/checkNoStartupTestWiring.js",
    "check:sync-config": "node scripts/checkSyncConfig.js",
    "test:unit": "jest --runInBand",
    "test:local": "jest --runInBand data/workspace data/dev",
    "test:sync": "jest --runInBand data/sync data/validation",
    "test:dev": "npm run check:no-startup-test-wiring && npm run test:local && npm run test:sync"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-picker/picker": "2.11.1",
    "axios": "^1.6.7",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-dropdown-picker": "^5.4.6",
    "react-native-dropdown-select-list": "^2.0.5",
    "react-native-modal-datetime-picker": "^17.1.0",
    "react-native-picker-select": "^9.1.3",
    "react-native-svg": "15.12.1",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.1.10",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "~54.0.11",
    "jest": "^29.7.0",
    "react-native-dotenv": "^3.4.9",
    "typescript": "~5.9.2"
  },
  "private": true
}
